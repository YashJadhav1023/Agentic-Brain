# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Dependencies
.env
.env.local
*.env
!.env.example
venv/
.venv/
env/
node_modules/

# Secrets, Keys & Credentials
*.key
*.pem
*.cert
*.crt
*service-account*.json
secrets*
creds*

# Runtime data & locks (ephemeral state)
runtime/*
!runtime/**/.gitkeep
!runtime/.gitkeep
.agents/
locks/*.lock
locks/*.json
!locks/.gitkeep
sessions/*.json
!sessions/.gitkeep
events/*.jsonl
events/*.log
!events/.gitkeep

# Ephemeral runtime databases & journals
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local test & task execution records
tasks/queue/*.json
tasks/active/*.json
tasks/completed/*.json
tasks/failed/*.json
handoffs/archive/*.md
handoffs/archive/*.json

# Manual pre-edit config snapshots (operator artifacts, not source)
backups/

# Local user configs & OS caches
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Editor/tool backup snapshots must never be tracked: they duplicate source and
# have leaked personal data in the past.
*.bak
*.bak-*

            "claude-opus-4-6-thinking",
            "claude-sonnet-4-6",
            "gemini-3.8-flash-high",
            "gemini-3.8-flash-medium",
            "gemini-3.8-flash-low",
            "gemini-3.7-flash-high",
            "gemini-3.7-flash-medium",
            "gemini-3.7-flash-low",
            "gemini-3.6-flash-high",
            "gemini-3.6-flash-medium",
            "gemini-3.6-flash-low",
            "gpt-oss-120b-medium"
          ],
          "default_model": "gemini-3.8-flash-medium"
        },
        "antigravity-account-3": {
          "agent_id": "antigravity-account-3",
          "account_id": "account-3",
          "enabled": true,
          "description": "Third Antigravity account (user@example.com); autonomous implementation, synthesis and verification",
          "execution": {
            "command": "~/.gemini/bin/agy",
            "app_data_dir": "antigravity-account-yash",
            "output_format": "json",
            "dangerously_skip_permissions": false,

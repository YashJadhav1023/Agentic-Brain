    "ollama": {
      "id": "ollama",
      "name": "Ollama (local)",
      "description": "Local model server. Category C (LOCAL) provider. Unauthenticated by default; no credential reference required.",
      "type": "ollama",
      "enabled": false,
      "enabled_reason": "Ollama daemon is not installed on this machine. Set enabled=true after `ollama serve` is reachable at base_url.",
      "base_url": "http://localhost:11434/v1",
      "native_api_url": "http://localhost:11434/api",
      "default_model": "llama3.2",
      "models": [],
      "models_verified_with": "GET /api/tags on the running daemon; never hard-coded",
      "credential_ref": "",
      "accounts": {}
    },
    "openai": {
      "id": "openai",
      "name": "Openai",
      "enabled": true,
      "accounts": {
        "openai-generic-1": {
          "agent_id": "openai-generic-1",
          "account_id": "generic-1",
          "provider_id": "openai",
          "enabled": true,
          "authentication_type": "api_key",
          "credential_reference": "secret://mission-control/openai/generic-1",
          "models": [],
          "capabilities": [
            "chat",
            "streaming"
          ]
        }
      }
    },
    "claude": {
      "id": "claude",
      "name": "Claude Code",
      "description": "Headless Claude Code execution across isolated subscription accounts",
      "enabled": true,
      "command": "~/.local/bin/claude",
      "fallback_commands": [
        "claude",
        "/usr/local/bin/claude"
      ],
      "profile_root": "~/.mission-control/claude",
      "models_verified_with": "claude --help on 2.1.280 (aliases) plus the model ids the CLI accepts",
      "auth_modes": {
        "subscription": "Pro/Max seat logged in with the official CLI; no secret is held by this project",
        "oauth_token": "Long-lived token from `claude setup-token`, stored in the CredentialManager",
        "api_key": "Pay-per-token sk-ant-... key, stored in the CredentialManager"
      },
      "use_pxpipe": false,
      "accounts": {
        "claude-account-1": {
          "agent_id": "claude-account-1",
          "account_id": "account-1",
          "provider_id": "claude",
          "enabled": true,
          "description": "Primary Claude subscription; reuses the existing ~/.claude login",
          "auth_mode": "subscription",
          "authentication_type": "subscription",
          "credential_reference": "",
          "config_dir": "~/.claude",
          "use_pxpipe": true,
          "execution": {
            "command": "~/.local/bin/claude",
            "output_format": "json",
            "dangerously_skip_permissions": false,
            "default_timeout_seconds": 300
          },
          "capabilities": [
            "deep-reasoning",
            "architecture",
            "code-review",
            "component-refactoring",
            "editor-refactoring",
            "test-scaffolding",
            "documentation"
          ],
          "models": [
            "sonnet",
            "opus",
            "haiku"
          ],
          "default_model": "sonnet",
          "fallback_model": "haiku"
        }
      }
    }
  },
  "future_providers": {
    "note": "Not implemented. Documents the registration lifecycle a new ProviderAdapter follows so the core brain never changes: REGISTER -> AUTHENTICATE -> HEALTH CHECK -> DISCOVER MODELS -> DISCOVER CAPABILITIES -> REGISTER AGENT -> ROUTER -> MISSION CONTROL.",
    "gemini-api": {
      "enabled": false,
      "status": "not-implemented"
    }
  },
  "integrations": {
    "pxpipe": {
      "enabled": true,
      "description": "Local loopback proxy (MIT, upstream teamchong/pxpipe) that renders bulky request context as PNG pages to cut input tokens. Opt-in per account via use_pxpipe, because imaged content is lossy for exact strings.",
      "port": 47821,
      "host": "127.0.0.1",
      "repo_dir": "~/YashDevops/pxpipe",
      "executable": "",
      "events_file": "~/.pxpipe/events.jsonl",
      "models": "claude-fable-5,claude-sonnet-5,claude-opus-5,gemini",
      "upstream": "https://github.com/teamchong/pxpipe",
      "license": "MIT",
      "models_note": "Model ids pxpipe is allowed to image. claude-sonnet-5 and claude-opus-5 are the ids Claude Code actually sends here; pxpipe has no measured dense profile for them, so it renders them with its safer 'legible' geometry (resolveClaudeProfile in src/core/claude-model-profiles.ts) rather than risking silent misreads. Caveat: upstream issue 216 reports the legible profile bailing out of history collapse on very long opus-5 sessions, which sends raw history as text and can 400. Drop claude-opus-5 here if you hit that."
    }
  }
}

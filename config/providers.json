          ],
          "default_model": "anthropic/claude-fable-5.1"
        },
        "cline-account-2": {
          "agent_id": "cline-account-2",
          "account_id": "account-2",
          "enabled": true,
          "config_dir": "~/.mission-control/cline/account-2/config",
          "data_dir": "~/.mission-control/cline/account-2/data",
          "capabilities": [
            "editor-refactoring",
            "frontend-styling",
            "component-refactoring",
            "code-review"

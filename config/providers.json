{
  "version": "2.0.0",
  "notes": [
    "Single source of truth for provider, account, execution and model configuration.",
    "No adapter may hard-code a CLI flag, profile directory or model id.",
    "Antigravity model lists were enumerated live with `agy --app_data_dir=<dir> models`.",
    "dangerously_skip_permissions is false everywhere: headless execution was verified to succeed without it."
  ],
  "concurrency": {
    "max_concurrent_agents": 3,
    "rationale": "3 CPU-bounded concurrent workers across isolated Antigravity accounts; bounded to avoid oversubscription."
  },
  "providers": {
    "antigravity": {
      "id": "antigravity",
      "name": "Google Antigravity",
      "description": "Autonomous multi-agent execution across isolated account profiles",
      "enabled": true,
      "command": "~/.gemini/bin/agy",
      "fallback_commands": [
        "~/.local/bin/agy",
        "~/.local/bin/antigravity",
        "/usr/local/bin/antigravity"
      ],
      "profile_root": "~/.gemini",
      "accounts": {
        "antigravity-account-1": {
          "agent_id": "antigravity-account-1",
          "account_id": "account-1",
          "enabled": true,
          "description": "First Antigravity account (jadhavpc0707@gmail.com); master architect and deep reasoning",
          "execution": {
            "command": "~/.gemini/bin/agy",
            "app_data_dir": "antigravity-account-jadhav",
            "output_format": "json",
            "dangerously_skip_permissions": false,
            "default_timeout_seconds": 300
          },
          "capabilities": [
            "architecture",
            "protocol-design",
            "governance",
            "deep-reasoning",
            "documentation"
          ],
          "models": [
            "gemini-3.1-pro-high",
            "gemini-3.1-pro-low",
            "claude-opus-4-6-thinking",
            "claude-sonnet-4-6",
            "gemini-3.8-flash-high",
            "gemini-3.8-flash-medium",
            "gemini-3.8-flash-low",
            "gemini-3.7-flash-high",
            "gemini-3.7-flash-medium",
            "gemini-3.7-flash-low",
            "gemini-3.6-flash-high",
            "gemini-3.6-flash-medium",
            "gemini-3.6-flash-low",
            "gpt-oss-120b-medium"
          ],
          "default_model": "gemini-3.8-flash-medium"
        },
        "antigravity-account-2": {
          "agent_id": "antigravity-account-2",
          "account_id": "account-2",
          "enabled": true,
          "description": "Second Antigravity account (anitigravity590@gmail.com); multi-file refactoring, component work and code review",
          "execution": {
            "command": "~/.gemini/bin/agy",
            "app_data_dir": "antigravity-account-3",
            "output_format": "json",
            "dangerously_skip_permissions": false,
            "default_timeout_seconds": 300

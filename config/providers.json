    "kiro": {
      "id": "kiro",
      "name": "Kiro",
      "description": "Headless command-line agent for terminal operations, cloud reads and testing",
      "enabled": true,
      "command": "~/.local/bin/kiro-cli",
      "models_verified_with": "kiro-cli chat --model <invalid> (the CLI lists valid ids in its error)",
      "accounts": {
        "kiro-cli": {
          "agent_id": "kiro-cli",
          "account_id": "cli",
          "enabled": true,
          "capabilities": [
            "terminal-operations",
            "local-validation",
            "build-and-test",
            "cloud-read-only",
            "kubernetes-read-only"
          ],
          "models": [
            "auto",
            "claude-opus-5",
            "claude-sonnet-5",
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "claude-sonnet-4.6",
            "claude-sonnet-4.5",
            "claude-sonnet-4",
            "claude-haiku-4.5",
            "deepseek-3.2",
            "minimax-m2.5",
            "minimax-m2.1",
            "glm-5",
            "qwen3-coder-next"
          ],
          "default_model": "auto"
        }
      }
    },
    "cline": {
      "id": "cline",
      "name": "Cline",
      "description": "Headless focused-coding and UI styling agent",
      "enabled": true,
      "command": "~/.local/bin/cline",
      "models_verified_with": "Verified live from ~/.cline/data/settings/providers.json and CLI execution",
      "model_capabilities": [
        {
          "id": "anthropic/claude-fable-5.1",
          "name": "Claude Fable 5.1 (Anthropic)",
          "availability": "configured",
          "billing": "standard",
          "reason": "Active configured model in Cline account 1 and account 2"
        },
        {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "availability": "free",
          "billing": "free",
          "reason": "Cline OAuth free usage billing ($0.00 cost)"
        },
        {
          "id": "z-ai/glm-5.3-flash",
          "name": "GLM 5.3 Flash",
          "availability": "active",
          "billing": "standard",
          "reason": "Active primary model in system profile"
        },
        {
          "id": "auto",
          "name": "Auto (Active Provider Model)",
          "availability": "free",
          "billing": "free",
          "reason": "Auto-selects active provider configured model"
        }
      ],
      "accounts": {
        "cline-account-1": {
          "agent_id": "cline-account-1",
          "account_id": "account-1",
          "enabled": true,
          "config_dir": "~/.mission-control/cline/account-1/config",

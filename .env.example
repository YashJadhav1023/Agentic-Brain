# Agentic Shared Memory Configuration
# Core Environment Settings (Do not put real secrets in this file)

# Machine Configuration
MAX_CONCURRENT_AGENTS=2
BRAIN_PORT=3333
BRAIN_SIDECAR_PORT=3334

# Data Directories
# Where this install keeps its shared-brain store. Defaults to ~/agentic-brain.
BRAIN_DIR=~/agentic-brain

# Antigravity Account Configurations
BRAIN_ANTIGRAVITY_OAUTH_DATA_DIR=antigravity-cli
BRAIN_ANTIGRAVITY_ACCOUNT2_DATA_DIR=antigravity-ide

# Optional Future API Provider Keys (leave empty by default)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Mission Control Security (Optional: if unset, automatically generated in runtime/mission_control.token)
# MISSION_CONTROL_AUTH_TOKEN=your_secure_bearer_token_here
